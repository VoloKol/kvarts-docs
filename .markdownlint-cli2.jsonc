{
  "config": {
    "default": true,
    // длина строки не ограничиваем: переносы не влияют на чанкинг
    "MD013": false,
    // одинаковые заголовки разрешены у разных родителей (FAQ в разных разделах)
    "MD024": { "siblings_only": true },
    // title во front matter не считается дубликатом H1
    "MD025": { "front_matter_title": "" },
    // без HTML: YFM экранирует теги как текст
    "MD033": true,
    // без «жирного текста вместо заголовка»
    "MD036": true,
    // каждый код-блок — с указанием языка
    "MD040": true,
    // статья начинается с H1
    "MD041": true,
    // YFM-расширенные таблицы (#| || |#) — легитимный формат портала,
    // plain-Markdown правило о стиле колонок к ним неприменимо
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "**/.tools/**", "**/vale-bin/**"]
}
